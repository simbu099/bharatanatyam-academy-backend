PORT=5000
NODE_ENV=development

MONGO_URI=your_mongodb_connection_string

JWT_SECRET=your_strong_random_jwt_secret
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:5173

# Used one-time by utils/seeder.js to create the first admin account.
# Not read by the running server itself.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_before_seeding

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Jothi Classical Dancing Academy <your_email@gmail.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
